# Required: PostgreSQL connection used by Next.js and database scripts.
# Example only — replace the credentials and database name for your environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ielts_mock_test

# Required in production: use a long, unique secret. Never rely on a default password.
ADMIN_PASSWORD=replace_with_a_long_unique_admin_password

# Public canonical URL used in email links and site metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Gmail SMTP transactional email via Nodemailer.
# Create a Google App Password with 2-Step Verification; do not use your normal Gmail password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
# Optional display address. It must be the Gmail account or a Gmail-approved sending alias.
EMAIL_FROM="IELTS Mock Test <your-gmail-address@gmail.com>"

# Optional: Google OAuth. In Google Cloud, register this exact redirect URI:
# https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional: TextBee transactional SMS. Keep this server-side only; never expose
# it as a NEXT_PUBLIC_ variable or commit an actual key.
TEXTBEE_API_KEY=your-textbee-api-key
# Optional only when using a self-hosted TextBee gateway.
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
