{
  "name": "ielts-mock-test",
  "version": "0.1.0",
  "description": "A Bengali-first IELTS mock-test and learning platform.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadworkspacex2-pixel/IELTS-MOCK-TEST.git"
  },
  "bugs": {
    "url": "https://github.com/saadworkspacex2-pixel/IELTS-MOCK-TEST/issues"
